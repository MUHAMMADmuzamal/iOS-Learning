    #nprogress .bar {
      background: #15C3EF;
      position: fixed;
      z-index: 1031;
      top: 0;
      left: 0;
      width: 100%;
      height: 2px;
    }
    #nprogress .peg {
      display: block;
      position: absolute;
      right: 0px;
      width: 100px;
      height: 100%;
      box-shadow: 0 0 10px #15C3EF, 0 0 5px #15C3EF;
      opacity: 1.0;
      -webkit-transform: rotate(3deg) translate(0px, -4px);
